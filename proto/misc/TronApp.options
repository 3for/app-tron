ExchangeDetails.token1Id    max_length: 19  /* Up to 19 digits, or "_" */
ExchangeDetails.token1Name  max_length: 32
ExchangeDetails.token2Id    max_length: 19  /* Up to 19 digits, or "_" */
ExchangeDetails.token2Name  max_length: 32
ExchangeDetails.signature   max_size: 72

TokenDetails.name           max_length: 32
TokenDetails.signature      max_size: 72
