+        TEST((s = S("\x81\x00"), pb_decode_varint32(&s, &u) && u == 1));
         TEST((s = S("\xFF\xFF\xFF\xFF\x0F"), pb_decode_varint32(&s, &u) && u == UINT32_MAX));
